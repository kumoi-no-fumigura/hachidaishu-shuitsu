 "poems": [
  {
   "seq": "1",
   "text": "花の色はうつりにけりないたつらに我身世にふるなかめせしまに",
   "kana": "",
   "speaker": "小町",
   "page": 1,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "鳴渡るかりの涙や落つらん物おもふやとの萩の上の前",
   "kana": "",
   "speaker": "よみ人しす",
   "page": 1,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "白露も時雨もいたくもる山は下葉のこらす色付にけり",
   "kana": "",
   "speaker": "貫之",
   "page": 1,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "朝ほかけ有明の月と見るまてに吉野のさとにふれる白雪",
   "kana": "",
   "speaker": "是則",
   "page": 1,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "立別れいなはの山の峯に生る松としきかは今かへりこむ",
   "kana": "",
   "speaker": "行平",
   "page": 1,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "此たひはぬさもとりあへす手向山紅葉の錦神のまに〳〵",
   "kana": "",
   "speaker": "菅家",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "在明のつれなく見えし別より暁はかりうき物はなし",
   "kana": "",
   "speaker": "忠岑",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "名とりあせゝの埋木あらはれはいかにせんとかあひみそめけむ",
   "kana": "",
   "speaker": "よみ人しらす",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "わくらみにとふ人あらはすまの浦にもしほたれつゝわふとこたへよ",
   "kana": "",
   "speaker": "行平",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "誰みそきゆふつけとりかから衣立たの山におりはへてなく",
   "kana": "",
   "speaker": "読人不知",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古今集",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "つゝめともかくれぬ物は夏虫の身よりあまれるおもひなりけり",
   "kana": "",
   "speaker": "人丸",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後撰集",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "しら露に風の吹しく秋のゝはつらぬきとめぬ玉そ敷ける",
   "kana": "",
   "speaker": "胡康",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後撰集",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "秋の田のかりほの庵のとまをあらみわか衣手は露にぬれつゝ",
   "kana": "",
   "speaker": "天智天皇",
   "page": 2,
   "pid": "nijl-200007037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後撰集",
   "kotobagaki": ""
  },
  {
